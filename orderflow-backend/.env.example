# PostgreSQL connection (PG 13+; extensions citext + pgcrypto are enabled by migration 001)
DATABASE_URL=postgres://orderflow:orderflow@localhost:5432/orderflow

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# 32-byte key, base64-encoded (openssl rand -base64 32), used to encrypt the
# client TIN column at rest. Changing this after TINs exist makes them
# undecryptable — treat it like JWT_SECRET, generate once and keep it.
TIN_ENCRYPTION_KEY=

# Server
PORT=4000
# Base URL used inside emailed upload links, e.g. https://pay.orderflow.ph
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated allowed origins for browser requests (e.g. your Vercel domain). "*" allows any origin.
CORS_ORIGIN=*

# Receipt storage. "local" writes under UPLOAD_DIR; swap StorageService for S3 in production.
UPLOAD_DIR=./data/receipts
# Applies to receipts, order attachments, and client documents. Hard-capped at 5 MB in code
# regardless of this value — this can only lower the limit, never raise it above 5.
MAX_UPLOAD_MB=5

# Email. Prefer RESEND_API_KEY — sends over HTTPS, which works even on hosts
# (Railway included) that block outbound SMTP. SMTP_URL is a fallback for
# hosts/providers where raw SMTP actually works. With neither set, emails are
# logged to the console (dev mode).
RESEND_API_KEY=
# Example: smtp://user:pass@email-smtp.ap-southeast-1.amazonaws.com:587
SMTP_URL=
MAIL_FROM="OrderFlow Billing <billing@orderflow.ph>"
# Full order details are forwarded here whenever an order is approved. Leave empty to skip.
SALES_FORWARD_EMAIL=

# Business timezone for reminder send windows
APP_TZ=Asia/Manila

# Upload token lifetime in days
TOKEN_TTL_DAYS=30
